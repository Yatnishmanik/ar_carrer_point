# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ar_career_point?schema=public"

# Authentication JWT Secret
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required only for seeding local test accounts; choose your own passwords.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
