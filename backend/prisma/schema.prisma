datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id         String        @id @default(uuid())
  name       String
  email      String        @unique
  password   String
  phone      String?
  role       Role          @default(STUDENT)
  targetExam String?
  attempts   TestAttempt[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("users")
}

model ExamCategory {
  id          String   @id @default(uuid())
  name        String
  code        String
  icon        String
  colorClass  String?
  accentColor String?
  gradient    String?
  items       String[]
  testCount   Int      @default(0)
  category    String   // 'bihar-board', 'competitive', 'all'
  tests       Test[]
  createdAt   DateTime @default(now())

  @@map("exam_categories")
}

model Test {
  id              String        @id @default(uuid())
  title           String
  subtitle        String?
  categoryId      String?
  category        ExamCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName    String
  durationMinutes Int           @default(10)
  totalMarks      Float         @default(0)
  passingMarks    Float         @default(0)
  instructions    String[]
  isPublished     Boolean       @default(true)
  questions       Question[]
  attempts        TestAttempt[]
  practiceSets    PracticeSet[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("tests")
}

model Question {
  id            String       @id @default(uuid())
  testId        String?
  test          Test?        @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String
  subject       String?
  explanation   String?
  marks         Float        @default(1.0)
  negativeMarks Float        @default(0.25)
  order         Int          @default(0)
  options       Option[]
  userAnswers   UserAnswer[]
  createdAt     DateTime     @default(now())

  @@map("questions")
}

model Option {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean      @default(false)
  order       Int          @default(0)
  userAnswers UserAnswer[]

  @@map("options")
}

model TestAttempt {
  id               String       @id @default(uuid())
  testId           String
  test             Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  score            Float
  maxScore         Float
  percentage       Float
  passed           Boolean
  correctCount     Int
  incorrectCount   Int
  unansweredCount  Int
  timeSpentSeconds Int
  userAnswers      UserAnswer[]
  createdAt        DateTime     @default(now())

  @@map("test_attempts")
}

model UserAnswer {
  id               String      @id @default(uuid())
  attemptId        String
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean     @default(false)
  marksAwarded     Float       @default(0.0)

  @@map("user_answers")
}

model PracticeSet {
  id              String   @id @default(uuid())
  testId          String?
  test            Test?    @relation(fields: [testId], references: [id], onDelete: SetNull)
  title           String
  subject         String
  category        String
  questionsCount  Int      @default(25)
  durationMinutes Int      @default(30)
  pdfUrl          String?
  isFree          Boolean  @default(true)
  difficulty      String   @default("Moderate")
  createdAt       DateTime @default(now())

  @@map("practice_sets")
}

model NoticeUpdate {
  id        String   @id @default(uuid())
  title     String
  date      String
  badge     String?
  link      String?
  createdAt DateTime @default(now())

  @@map("notice_updates")
}
