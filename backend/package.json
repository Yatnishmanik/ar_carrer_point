{
  "name": "backend",
  "version": "1.0.0",
  "description": "AR Career Point Backend API - Node.js, Express, TypeScript, PostgreSQL, Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/prisma.cjs generate",
    "prisma:migrate": "node scripts/prisma.cjs migrate dev",
    "prisma:push": "node scripts/prisma.cjs db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "node scripts/prisma.cjs studio",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
